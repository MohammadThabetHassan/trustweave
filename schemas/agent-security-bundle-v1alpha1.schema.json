{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/bundle/v1alpha1",
  "title": "TrustWeave Agent Security Bundle v1alpha1",
  "type": "object",
  "required": ["schema_version", "manifest", "policy", "findings", "summary", "limits"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/bundle/v1alpha1"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "policy": {"$ref": "#/$defs/policy"},
    "findings": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/finding"}},
    "summary": {"$ref": "#/$defs/summary"},
    "limits": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "rule_identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "trust": {"enum": ["trusted", "untrusted", "conditional"]},
    "action": {"enum": ["read", "write", "sensitive", "external"]},
    "decision": {"enum": ["allow", "deny", "require_approval"]},
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "source": {"type": "object", "required": ["name", "trust", "data_classification", "description"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "trust": {"$ref": "#/$defs/trust"}, "data_classification": {"type": "string", "minLength": 1, "maxLength": 64}, "description": {"$ref": "#/$defs/text"}}, "additionalProperties": false},
    "tool": {"type": "object", "required": ["name", "action_class", "capabilities", "description"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "action_class": {"$ref": "#/$defs/action"}, "capabilities": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "description": {"$ref": "#/$defs/text"}}, "additionalProperties": false},
    "flow": {"type": "object", "required": ["source", "tool", "purpose", "purpose_tags"], "properties": {"source": {"$ref": "#/$defs/identifier"}, "tool": {"$ref": "#/$defs/identifier"}, "purpose": {"$ref": "#/$defs/text"}, "purpose_tags": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}, "additionalProperties": false},
    "manifest": {"type": "object", "required": ["schema_version", "name", "description", "sources", "tools", "flows"], "properties": {"schema_version": {"const": "trustweave.dev/v1alpha1"}, "name": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}, "sources": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/source"}}, "tools": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/tool"}}, "flows": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/flow"}}}, "additionalProperties": false},
    "rule": {"type": "object", "required": ["id", "description", "source_trust", "tool_action_classes", "decision", "rationale", "source_data_classifications", "tool_capabilities", "severity", "source_identifiers", "tool_identifiers", "purpose_tags", "source_data_classification_at_least", "source_data_classification_at_most", "required_controls"], "properties": {"id": {"$ref": "#/$defs/rule_identifier"}, "description": {"$ref": "#/$defs/text"}, "source_trust": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/trust"}}, "tool_action_classes": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/action"}}, "decision": {"$ref": "#/$defs/decision"}, "rationale": {"$ref": "#/$defs/text"}, "source_data_classifications": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 64}}, "tool_capabilities": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "severity": {"anyOf": [{"$ref": "#/$defs/severity"}, {"type": "null"}]}, "source_identifiers": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/identifier"}}, "tool_identifiers": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/identifier"}}, "purpose_tags": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/identifier"}}, "source_data_classification_at_least": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]}, "source_data_classification_at_most": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]}, "required_controls": {"type": "array", "maxItems": 2, "items": {"enum": ["approval", "approval.fail_closed"]}}}, "additionalProperties": false},
    "policy": {"type": "object", "required": ["schema_version", "name", "default_decision", "classification_taxonomy", "approval_control", "rules"], "properties": {"schema_version": {"enum": ["trustweave.dev/v1alpha1", "trustweave.dev/policy/v1alpha2"]}, "name": {"type": "string", "minLength": 1, "maxLength": 128}, "default_decision": {"$ref": "#/$defs/decision"}, "classification_taxonomy": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}, "approval_control": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["mechanism", "binds_to", "fail_closed"], "properties": {"mechanism": {"$ref": "#/$defs/text"}, "binds_to": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}, "fail_closed": {"type": "boolean"}}, "additionalProperties": false}]}, "rules": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/rule"}}}, "additionalProperties": false},
    "finding": {"type": "object", "required": ["flow", "source", "tool", "decision", "severity", "rule_id", "rationale"], "properties": {"flow": {"$ref": "#/$defs/flow"}, "source": {"$ref": "#/$defs/source"}, "tool": {"$ref": "#/$defs/tool"}, "decision": {"$ref": "#/$defs/decision"}, "severity": {"$ref": "#/$defs/severity"}, "rule_id": {"anyOf": [{"$ref": "#/$defs/rule_identifier"}, {"type": "null"}]}, "rationale": {"$ref": "#/$defs/text"}}, "additionalProperties": false},
    "summary": {"type": "object", "required": ["allow", "deny", "require_approval"], "properties": {"allow": {"type": "integer", "minimum": 0, "maximum": 10000}, "deny": {"type": "integer", "minimum": 0, "maximum": 10000}, "require_approval": {"type": "integer", "minimum": 0, "maximum": 10000}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
