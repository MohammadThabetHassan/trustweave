{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/policy/v1alpha2",
  "title": "TrustWeave Policy v1alpha2",
  "type": "object",
  "required": ["schema_version", "name", "default_decision", "rules"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/policy/v1alpha2"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "default_decision": {"enum": ["allow", "deny", "require_approval"]},
    "classification_taxonomy": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "rules": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "approval_control": {"type": "object"}
  },
  "additionalProperties": false
}
