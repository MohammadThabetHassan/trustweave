{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/scenario-pack/v1alpha1",
  "title": "TrustWeave Synthetic Scenario Pack v1alpha1",
  "type": "object",
  "required": ["schema_version", "name", "scenarios"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/v1alpha1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "scenarios": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
