{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/agent-manifest/v1alpha1.json",
  "title": "TrustWeave Agent Manifest",
  "description": "A declarative, non-executable description of agent sources, tools, and trust-boundary flows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "sources", "tools", "flows"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/v1alpha1"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tool"}
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/flow"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "trust", "data_classification", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "trust": {"enum": ["trusted", "untrusted", "conditional"]},
        "data_classification": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "action_class", "capabilities", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "action_class": {"enum": ["read", "write", "sensitive", "external"]},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "description": {"type": "string", "minLength": 1}
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "tool", "purpose"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    }
  }
}
