{
  "schema_version": "trustweave.dev/v1alpha1",
  "name": "support-agent-boundary-regressions",
  "scenarios": [
    {
      "id": "TW-SC-001",
      "description": "A trusted request may use a declared read-only retrieval action.",
      "source_trust": "trusted",
      "tool_action_class": "read",
      "expected_decision": "allow"
    },
    {
      "id": "TW-SC-002",
      "description": "Conditional confidential context requires approval before a mock external action.",
      "source_trust": "conditional",
      "tool_action_class": "external",
      "expected_decision": "require_approval"
    },
    {
      "id": "TW-SC-003",
      "description": "Untrusted retrieved text cannot directly cause an external mock action.",
      "source_trust": "untrusted",
      "tool_action_class": "external",
      "expected_decision": "deny"
    },
    {
      "id": "TW-SC-004",
      "description": "Untrusted content cannot directly cause sensitive data access.",
      "source_trust": "untrusted",
      "tool_action_class": "sensitive",
      "expected_decision": "deny"
    },
    {
      "id": "TW-SC-005",
      "description": "An unmatched conditional write flow fails closed under the default policy.",
      "source_trust": "conditional",
      "tool_action_class": "write",
      "expected_decision": "deny"
    }
  ]
}
