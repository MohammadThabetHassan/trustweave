{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/chain-manifest/v1alpha1",
  "title": "TrustWeave Declared Chain Manifest v1alpha1",
  "type": "object",
  "required": ["schema_version", "name", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/chain-manifest/v1alpha1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object"}},
    "edges": {"type": "array", "maxItems": 10000, "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
