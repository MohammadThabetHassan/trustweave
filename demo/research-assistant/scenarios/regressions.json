      "expected_decision": "deny"
    },
    {
      "id": "RA-SC-004",
      "description": "Web page content cannot post to Slack.",
      "source_trust": "untrusted",
      "tool_action_class": "external",
      "expected_decision": "deny"
    },
    {
      "id": "RA-SC-005",
      "description": "Anything unmatched fails closed.",
