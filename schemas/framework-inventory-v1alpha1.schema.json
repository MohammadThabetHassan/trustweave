{
  "$defs": {
    "agent_entry": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "agent"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "tools": {
          "$ref": "#/$defs/string_list"
        }
      },
      "required": [
        "kind",
        "name",
        "tools"
      ],
      "type": "object"
    },
    "count": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "evidence_kind": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        "id": {
          "pattern": "^TW-[A-Z0-9-]{1,120}$",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/string_map"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/property_map"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/string_map"
          },
          "maxItems": 64,
          "type": "array"
        },
        "remediation": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "review"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "message",
        "evidence_kind"
      ],
      "type": "object"
    },
    "framework_entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/graph_entry"
        },
        {
          "$ref": "#/$defs/agent_entry"
        },
        {
          "$ref": "#/$defs/task_entry"
        }
      ]
    },
    "graph_entry": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "graph"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "reference": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "kind",
        "name",
        "reference"
      ],
      "type": "object"
    },
    "identifier": {
      "pattern": "^[a-z][a-z0-9_-]{0,127}$",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "property_map": {
      "additionalProperties": {
        "oneOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          {
            "$ref": "#/$defs/string_list"
          }
        ]
      },
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "rule_id": {
      "pattern": "^TW-[A-Z0-9-]{1,120}$",
      "type": "string"
    },
    "string_list": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "string_map": {
      "additionalProperties": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "subject": {
      "additionalProperties": {
        "oneOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "$ref": "#/$defs/string_list"
          }
        ]
      },
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "task_entry": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "const": "task"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "tools": {
          "$ref": "#/$defs/string_list"
        }
      },
      "required": [
        "kind",
        "name",
        "agent",
        "tools"
      ],
      "type": "object"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "https://trustweave.dev/schemas/framework-inventory/v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/framework_entry"
      },
      "maxItems": 1000000,
      "type": "array"
    },
    "framework": {
      "enum": [
        "langgraph",
        "openai-agents",
        "crewai"
      ]
    },
    "limits": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "trustweave.dev/framework-inventory/v1alpha1"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "agent_count": {
          "$ref": "#/$defs/count"
        },
        "entry_count": {
          "$ref": "#/$defs/count"
        },
        "graph_count": {
          "$ref": "#/$defs/count"
        },
        "task_count": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "entry_count",
        "agent_count",
        "task_count",
        "graph_count"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "framework",
    "entries",
    "summary",
    "limits"
  ],
  "title": "TrustWeave Framework Inventory v1alpha1",
  "type": "object"
}
