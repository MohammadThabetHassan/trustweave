{
  "$defs": {
    "annotation": {
      "additionalProperties": false,
      "properties": {
        "destructiveHint": {
          "type": "boolean"
        },
        "idempotentHint": {
          "type": "boolean"
        },
        "openWorldHint": {
          "type": "boolean"
        },
        "readOnlyHint": {
          "type": "boolean"
        },
        "title": {
          "$ref": "#/$defs/text"
        }
      },
      "type": "object"
    },
    "count": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "evidence_kind": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        "id": {
          "pattern": "^TW-[A-Z0-9-]{1,120}$",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/string_map"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/property_map"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/string_map"
          },
          "maxItems": 64,
          "type": "array"
        },
        "remediation": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "review"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "message",
        "evidence_kind"
      ],
      "type": "object"
    },
    "identifier": {
      "pattern": "^[a-z][a-z0-9_-]{0,127}$",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "property_map": {
      "additionalProperties": {
        "oneOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          {
            "$ref": "#/$defs/string_list"
          }
        ]
      },
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "rule_id": {
      "pattern": "^TW-[A-Z0-9-]{1,120}$",
      "type": "string"
    },
    "string_list": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "string_map": {
      "additionalProperties": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "subject": {
      "additionalProperties": {
        "oneOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "$ref": "#/$defs/string_list"
          }
        ]
      },
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "input_schema": {
          "additionalProperties": true,
          "properties": {
            "additionalProperties": {
              "type": "boolean"
            },
            "properties": {
              "type": "object"
            },
            "required": {
              "items": {
                "$ref": "#/$defs/name"
              },
              "type": "array"
            },
            "type": {
              "const": "object"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "name",
        "input_schema"
      ],
      "type": "object"
    }
  },
  "$id": "https://trustweave.dev/schemas/mcp-tool-inventory/v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "limits": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "trustweave.dev/mcp-tool-inventory/v1alpha1"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "tool_count": {
          "$ref": "#/$defs/count"
        },
        "tools_with_annotations": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "tool_count",
        "tools_with_annotations"
      ],
      "type": "object"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/tool"
      },
      "maxItems": 1000000,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "tools",
    "summary",
    "limits"
  ],
  "title": "TrustWeave MCP Tool Inventory v1alpha1",
  "type": "object"
}
