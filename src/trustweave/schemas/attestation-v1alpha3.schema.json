{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/attestation/v1alpha3",
  "title": "TrustWeave Local Attestation v1alpha3",
  "type": "object",
  "required": ["schema_version", "subject", "predicate_type", "predicate", "integrity", "limits"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/attestation/v1alpha3"},
    "subject": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/subject"}
    },
    "predicate_type": {
      "const": "https://trustweave.dev/attestation/local-evidence/v1alpha3"
    },
    "predicate": {
      "type": "object",
      "required": ["source_revision", "stable_payload", "exact_files"],
      "properties": {
        "source_revision": {"type": "string", "minLength": 1, "maxLength": 1024},
        "stable_payload": {
          "type": "object",
          "required": ["bundle_sha256", "test_results_sha256"],
          "properties": {
            "bundle_sha256": {"$ref": "#/$defs/sha256"},
            "test_results_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "exact_files": {
          "type": "object",
          "required": ["bundle", "test_results"],
          "properties": {
            "bundle": {"$ref": "#/$defs/file_binding"},
            "test_results": {"$ref": "#/$defs/file_binding"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["chain_sha256", "covers"],
      "properties": {
        "chain_sha256": {"$ref": "#/$defs/sha256"},
        "covers": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 4096},
        "digest": {
          "type": "object",
          "required": ["sha256"],
          "properties": {"sha256": {"$ref": "#/$defs/sha256"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "file_binding": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
