{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/chain-review/v1alpha1",
  "title": "TrustWeave Declared Chain Review v1alpha1",
  "type": "object",
  "required": ["schema_version", "findings", "paths", "summary", "limits"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/chain-review/v1alpha1"},
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/finding"}
    },
    "paths": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["identity"],
        "properties": {
          "identity": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {"$ref": "#/$defs/text"}
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["declared_nodes", "review_findings", "paths", "edges_traversed", "states_explored"],
      "properties": {
        "declared_nodes": {"type": "integer", "minimum": 0, "maximum": 1000},
        "review_findings": {"type": "integer", "minimum": 0, "maximum": 1000},
        "paths": {"type": "integer", "minimum": 0, "maximum": 1000},
        "edges_traversed": {"type": "integer", "minimum": 0, "maximum": 5000},
        "states_explored": {"type": "integer", "minimum": 0, "maximum": 5000}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1024},
    "metadata_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "subject": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/metadata_key"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/text"},
          {
            "type": "array",
            "maxItems": 128,
            "items": {"$ref": "#/$defs/text"}
          }
        ]
      }
    },
    "location": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/metadata_key"},
      "additionalProperties": {"$ref": "#/$defs/text"}
    },
    "properties": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/metadata_key"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/text"},
          {"type": "boolean"},
          {"type": "integer", "minimum": 0, "maximum": 2147483647},
          {
            "type": "array",
            "maxItems": 128,
            "items": {"$ref": "#/$defs/text"}
          }
        ]
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "message", "evidence_kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^TW-[A-Z0-9-]{1,120}$"},
        "severity": {"enum": ["critical", "high", "medium", "low", "info", "review"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence_kind": {"const": "declared_chain_configuration"},
        "subject": {"$ref": "#/$defs/subject"},
        "location": {"$ref": "#/$defs/location"},
        "properties": {"$ref": "#/$defs/properties"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
