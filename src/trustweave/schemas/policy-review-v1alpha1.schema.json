{
  "$defs": {
    "count": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "coverage_result": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny",
            "require_approval"
          ]
        },
        "possible": {
          "type": "boolean"
        },
        "reachable": {
          "type": "boolean"
        },
        "shadowed_by": {
          "oneOf": [
            {
              "$ref": "#/$defs/rule_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "reachable",
        "possible",
        "shadowed_by",
        "decision"
      ],
      "type": "object"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "evidence_kind": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        "id": {
          "pattern": "^TW-[A-Z0-9-]{1,120}$",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/string_map"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/property_map"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/string_map"
          },
          "maxItems": 64,
          "type": "array"
        },
        "remediation": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "review"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "message",
        "evidence_kind"
      ],
      "type": "object"
    },
    "identifier": {
      "pattern": "^[a-z][a-z0-9_-]{0,127}$",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "property_map": {
      "additionalProperties": {
        "oneOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          {
            "$ref": "#/$defs/string_list"
          }
        ]
      },
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "rule_id": {
      "pattern": "^TW-[A-Z0-9-]{1,120}$",
      "type": "string"
    },
    "string_list": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "string_map": {
      "additionalProperties": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "subject": {
      "additionalProperties": {
        "oneOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "$ref": "#/$defs/string_list"
          }
        ]
      },
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "https://trustweave.dev/schemas/policy-review/v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_control": {
      "additionalProperties": false,
      "properties": {
        "binds_to": {
          "$ref": "#/$defs/string_list"
        },
        "declared": {
          "type": "boolean"
        },
        "fail_closed": {
          "type": "boolean"
        },
        "high_impact_approval_rules": {
          "items": {
            "$ref": "#/$defs/rule_id"
          },
          "maxItems": 1000000,
          "type": "array"
        },
        "mechanism": {
          "$ref": "#/$defs/text"
        },
        "missing_required_bindings": {
          "$ref": "#/$defs/string_list"
        }
      },
      "required": [
        "high_impact_approval_rules",
        "declared"
      ],
      "type": "object"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "impossible_rules": {
          "items": {
            "$ref": "#/$defs/rule_id"
          },
          "maxItems": 1000000,
          "type": "array"
        },
        "rules": {
          "additionalProperties": {
            "$ref": "#/$defs/coverage_result"
          },
          "maxProperties": 1000000,
          "type": "object"
        },
        "shadowed_rules": {
          "items": {
            "$ref": "#/$defs/rule_id"
          },
          "maxItems": 1000000,
          "type": "array"
        }
      },
      "required": [
        "rules",
        "shadowed_rules",
        "impossible_rules"
      ],
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 1000000,
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "limits": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/name"
    },
    "schema_version": {
      "const": "trustweave.dev/policy-review/v1alpha1"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "review_findings": {
          "$ref": "#/$defs/count"
        },
        "rules": {
          "$ref": "#/$defs/count"
        },
        "status": {
          "enum": [
            "clear",
            "review_required"
          ]
        }
      },
      "required": [
        "rules",
        "review_findings",
        "status"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "policy",
    "approval_control",
    "findings",
    "summary",
    "limits",
    "generated_at"
  ],
  "title": "TrustWeave Local Policy Review v1alpha1",
  "type": "object"
}
