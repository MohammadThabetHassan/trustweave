{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/chain-manifest/v1alpha1",
  "title": "TrustWeave Declared Chain Manifest v1alpha1",
  "type": "object",
  "required": ["schema_version", "name", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/chain-manifest/v1alpha1"},
    "name": {"$ref": "#/$defs/text"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 128},
    "classification": {"type": "string", "minLength": 1, "maxLength": 64},
    "trust": {"enum": ["trusted", "untrusted", "conditional"]},
    "action_class": {"enum": ["read", "write", "sensitive", "external"]},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_node": {
      "type": "object",
      "required": ["id", "kind", "trust"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "kind": {"const": "source"},
        "trust": {"$ref": "#/$defs/trust"},
        "classification": {"$ref": "#/$defs/classification"}
      },
      "additionalProperties": false
    },
    "data_node": {
      "type": "object",
      "required": ["id", "kind", "classification"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "kind": {"const": "data"},
        "classification": {"$ref": "#/$defs/classification"}
      },
      "additionalProperties": false
    },
    "tool_node": {
      "type": "object",
      "required": ["id", "kind", "action_class"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "kind": {"const": "tool"},
        "action_class": {"$ref": "#/$defs/action_class"}
      },
      "additionalProperties": false
    },
    "sink_node": {
      "type": "object",
      "required": ["id", "kind", "action_class"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "kind": {"const": "sink"},
        "action_class": {"$ref": "#/$defs/action_class"}
      },
      "additionalProperties": false
    },
    "approval_node": {
      "type": "object",
      "required": ["id", "kind", "fail_closed"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "kind": {"const": "approval"},
        "fail_closed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "sanitizer_node": {
      "type": "object",
      "required": ["id", "kind", "covers_classifications"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "kind": {"const": "sanitizer"},
        "covers_classifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/classification"}
        }
      },
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/source_node"},
        {"$ref": "#/$defs/data_node"},
        {"$ref": "#/$defs/tool_node"},
        {"$ref": "#/$defs/sink_node"},
        {"$ref": "#/$defs/approval_node"},
        {"$ref": "#/$defs/sanitizer_node"}
      ]
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/node_id"},
        "to": {"$ref": "#/$defs/node_id"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
