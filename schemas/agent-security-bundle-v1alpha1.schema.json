{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/bundle/v1alpha1",
  "title": "TrustWeave Agent Security Bundle v1alpha1",
  "description": "Compatibility schema for the exact bundle shape emitted by TrustWeave 0.1.1. Cross-reference, duplicate-identifier, first-match policy, and summary consistency rules are enforced by the dependency-free runtime validator.",
  "type": "object",
  "required": ["schema_version", "manifest", "policy", "findings", "summary", "limits"],
  "properties": {
    "schema_version": {"const": "trustweave.dev/bundle/v1alpha1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "policy": {"$ref": "#/$defs/policy"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/finding"}
    },
    "summary": {
      "type": "object",
      "required": ["allow", "deny", "require_approval"],
      "properties": {
        "allow": {"type": "integer", "minimum": 0},
        "deny": {"type": "integer", "minimum": 0},
        "require_approval": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["name", "trust", "data_classification", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "trust": {"enum": ["trusted", "untrusted", "conditional"]},
        "data_classification": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["name", "action_class", "capabilities", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "action_class": {"enum": ["read", "write", "sensitive", "external"]},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": ["source", "tool", "purpose"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["schema_version", "name", "description", "sources", "tools", "flows"],
      "properties": {
        "schema_version": {"const": "trustweave.dev/v1alpha1"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/source"}
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/tool"}
        },
        "flows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/flow"}
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "description", "source_trust", "tool_action_classes", "decision", "rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source_trust": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["trusted", "untrusted", "conditional"]}
        },
        "tool_action_classes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["read", "write", "sensitive", "external"]}
        },
        "decision": {"enum": ["allow", "deny", "require_approval"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["schema_version", "name", "default_decision", "rules"],
      "properties": {
        "schema_version": {"const": "trustweave.dev/v1alpha1"},
        "name": {"type": "string", "minLength": 1},
        "default_decision": {"enum": ["allow", "deny", "require_approval"]},
        "rules": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/rule"}
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["flow", "source", "tool", "decision", "rule_id", "rationale"],
      "properties": {
        "flow": {"$ref": "#/$defs/flow"},
        "source": {"$ref": "#/$defs/source"},
        "tool": {"$ref": "#/$defs/tool"},
        "decision": {"enum": ["allow", "deny", "require_approval"]},
        "rule_id": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
