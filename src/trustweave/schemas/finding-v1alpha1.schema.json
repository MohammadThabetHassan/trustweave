{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustweave.dev/schemas/finding/v1alpha1",
  "title": "TrustWeave Embedded Canonical Local Finding v1alpha1",
  "$comment": "Embedded findings inherit their schema version from the containing versioned artifact; they do not repeat schema_version.",
  "type": "object",
  "required": ["id", "severity", "message", "evidence_kind"],
  "properties": {
    "id": {"type": "string", "pattern": "^TW-[A-Z0-9-]{1,120}$"},
    "title": {"$ref": "#/$defs/title"},
    "severity": {"enum": ["critical", "high", "medium", "low", "info", "review"]},
    "message": {"$ref": "#/$defs/message"},
    "rationale": {"$ref": "#/$defs/message"},
    "remediation": {"$ref": "#/$defs/message"},
    "evidence_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
    "subject": {"$ref": "#/$defs/subject_map"},
    "location": {"$ref": "#/$defs/string_map"},
    "references": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/string_map"}
    },
    "properties": {"$ref": "#/$defs/safe_property_map"}
  },
  "$defs": {
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "message": {"type": "string", "minLength": 1, "maxLength": 4096},
    "metadata_string": {"type": "string", "minLength": 1, "maxLength": 1024},
    "metadata_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "string_map": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/metadata_key"},
      "additionalProperties": {"$ref": "#/$defs/metadata_string"}
    },
    "string_sequence": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/metadata_string"}
    },
    "subject_map": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/metadata_key"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/metadata_string"},
          {"$ref": "#/$defs/string_sequence"}
        ]
      }
    },
    "safe_property_map": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/metadata_key"},
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/metadata_string"},
          {"type": "boolean"},
          {"type": "integer", "minimum": 0, "maximum": 2147483647},
          {"$ref": "#/$defs/string_sequence"}
        ]
      }
    }
  },
  "additionalProperties": false
}
