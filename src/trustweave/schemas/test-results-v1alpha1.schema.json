{
  "$defs": {
    "count": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "evidence_kind": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        "id": {
          "pattern": "^TW-[A-Z0-9-]{1,120}$",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/string_map"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/property_map"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/string_map"
          },
          "maxItems": 64,
          "type": "array"
        },
        "remediation": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "review"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "message",
        "evidence_kind"
      ],
      "type": "object"
    },
    "identifier": {
      "pattern": "^[a-z][a-z0-9_-]{0,127}$",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "property_map": {
      "additionalProperties": {
        "oneOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          {
            "$ref": "#/$defs/string_list"
          }
        ]
      },
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "expected_decision": {
          "enum": [
            "allow",
            "deny",
            "require_approval"
          ]
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/scenario_input"
        },
        "observed_decision": {
          "enum": [
            "allow",
            "deny",
            "require_approval"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/reference"
          },
          "maxItems": 64,
          "type": "array"
        },
        "rule_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/rule_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "description",
        "title",
        "category",
        "rationale",
        "references",
        "input",
        "expected_decision",
        "observed_decision",
        "rule_id",
        "status"
      ],
      "type": "object"
    },
    "rule_id": {
      "pattern": "^TW-[A-Z0-9-]{1,120}$",
      "type": "string"
    },
    "scenario_input": {
      "additionalProperties": false,
      "properties": {
        "purpose_tag": {
          "$ref": "#/$defs/name"
        },
        "source_data_classification": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "source_identifier": {
          "$ref": "#/$defs/name"
        },
        "source_trust": {
          "enum": [
            "trusted",
            "untrusted",
            "conditional"
          ]
        },
        "tool_action_class": {
          "enum": [
            "read",
            "write",
            "sensitive",
            "external"
          ]
        },
        "tool_capabilities": {
          "$ref": "#/$defs/string_list"
        },
        "tool_identifier": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "source_trust",
        "tool_action_class"
      ],
      "type": "object"
    },
    "string_list": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "string_map": {
      "additionalProperties": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "subject": {
      "additionalProperties": {
        "oneOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          {
            "$ref": "#/$defs/string_list"
          }
        ]
      },
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "type": "object"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "https://trustweave.dev/schemas/test-results/v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "limits": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/name"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/result"
      },
      "maxItems": 1000000,
      "type": "array"
    },
    "schema_version": {
      "const": "trustweave.dev/test-results/v1alpha1"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "$ref": "#/$defs/count"
        },
        "passed": {
          "$ref": "#/$defs/count"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "total": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "status"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "policy",
    "summary",
    "results",
    "limits",
    "generated_at"
  ],
  "title": "TrustWeave Synthetic Test Results v1alpha1",
  "type": "object"
}
